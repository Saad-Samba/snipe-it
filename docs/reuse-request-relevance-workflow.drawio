        </mxCell>
        <mxCell id="subtitle" value="Current implementation + future enhancement direction for stakeholder review" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontColor=#6b7280;" vertex="1" parent="1">
          <mxGeometry x="40" y="50" width="520" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="current" value="Current Implementation" style="swimlane;startSize=28;rounded=1;html=1;fillColor=#eff6ff;strokeColor=#60a5fa;fontColor=#1e3a8a;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="90" width="860" height="420" as="geometry"/>
